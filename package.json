{
  "name": "ruko",
  "private": true,
  "version": "0.1.0",
  "description": "Ruko: a 60-second voice check, built on Bolna, that stops a payment scam before money leaves.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5410",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5411",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/run.ts",
    "eval:report": "tsx eval/report.ts",
    "bolna:setup": "tsx scripts/bolna-setup.ts",
    "bolna:check": "tsx scripts/bolna-check.ts",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run scan:secrets"
  },
  "dependencies": {
    "@bolna/web-call": "3.0.1",
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource/fragment-mono": "5.2.6",
    "@fontsource/instrument-serif": "5.2.6",
    "@fontsource/open-runde": "5.3.0",
    "@fontsource/silkscreen": "5.2.6",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.1",
    "lenis": "1.3.4",
    "lucide-react": "0.525.0",
    "motion": "12.23.12",
    "ogl": "1.0.11",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "22.15.34",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.30.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "puppeteer-core": "24.12.1",
    "tailwindcss": "4.1.11",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
