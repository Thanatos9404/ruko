{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": {
    "api/router.ts": {
      "maxDuration": 30,
      "includeFiles": "{data/patterns/library.json,data/patterns/sources.json,data/patterns/signal_cues.json,server/ml/model/**}"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/router?__p=/v1/:path*" },
    { "source": "/api/demo/:path*", "destination": "/api/router?__p=/api/demo/:path*" },
    { "source": "/api/console/:path*", "destination": "/api/router?__p=/api/console/:path*" },
    { "source": "/api/public/:path*", "destination": "/api/router?__p=/api/public/:path*" },
    { "source": "/api/live/:path*", "destination": "/api/router?__p=/api/live/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "microphone=(self), camera=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
