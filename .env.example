# Copy to .env (git-ignored). Never commit real values.

# Bolna (https://platform.bolna.ai). Create the key in the Bolna dashboard.
BOLNA_API_KEY=
# Written by `npm run bolna:setup`
BOLNA_CHECK_AGENT_ID=
BOLNA_CONTACT_AGENT_ID=
BOLNA_LINE_AGENT_ID=

# Secrets Bolna presents when it calls Ruko (generated by bolna:setup)
RUKO_TOOL_TOKEN=
RUKO_WEBHOOK_TOKEN=

# Public https URL where Bolna can reach /v1/bolna/tools/* and the webhook
RUKO_PUBLIC_BASE_URL=https://your-project.vercel.app

# Bank API keys, tenant:key pairs, comma-separated
RUKO_API_KEYS=demo-bank:rk_test_change_me
RUKO_BANK_NAME=Demo Bank

# Live-call gate (protects the credit budget)
RUKO_ACCESS_CODES=
RUKO_DAILY_CALL_CAP=12
RUKO_PER_VISITOR_DAILY_CAP=3
RUKO_WALLET_FLOOR_CENTS=350

# Phone calls cost telephony; keep off for the demo
RUKO_ALLOW_PHONE_CALLS=false
RUKO_CONTACT_WEB_RING=true

# Optional: Vercel Blob store for the durable audit archive
BLOB_READ_WRITE_TOKEN=
